PORT=3000
# Public site URL used in requester/donor emails (must match your deployed domain)
APP_URL=http://localhost:3000
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/blood
# If you get querySrv EREFUSED, add the direct string from Atlas (Connect → Drivers):
MONGO_URI_DIRECT=
JWT_SECRET=
SESSION_SECRET=

# Gmail App Password (16 characters) — https://myaccount.google.com/apppasswords
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=RedConnect <your.email@gmail.com>

# ========== AI CHATBOT (Google Gemini) ==========
# Get free API key at: https://makersuite.google.com/app/apikey
# If not set, chatbot uses keyword-based fallback
GEMINI_API_KEY=your-gemini-api-key-here
