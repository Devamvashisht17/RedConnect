PORT=3000
APP_URL=http://localhost:3000
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/blood
MONGO_URI_DIRECT=
JWT_SECRET=
SESSION_SECRET=

# ========== GOOGLE OAUTH ==========
# Get credentials at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Local development
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Production — uncomment when deploying:
# GOOGLE_CALLBACK_URL=https://your-app.onrender.com/auth/google/callback

# Gmail App Password (16 characters) — https://myaccount.google.com/apppasswords
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=RedConnect <your.email@gmail.com>

# ========== AI CHATBOT (Google Gemini) ==========
# Get free API key at: https://makersuite.google.com/app/apikey
# If not set, chatbot uses keyword-based fallback
GEMINI_API_KEY=your-gemini-api-key-here
