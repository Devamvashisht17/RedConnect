<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hospital Dashboard - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <% const inventoryGroups = ['A+','A-','B+','B-','AB+','AB-','O+','O-']; %>
  <% const inventoryMap = Object.fromEntries((hospital.inventory || []).map(item => [item.bloodGroup, item.units || 0])); %>
  <% const totalUnits = inventoryGroups.reduce((sum, group) => sum + (inventoryMap[group] || 0), 0); %>
  <% const lowStockGroups = inventoryGroups.filter(group => (inventoryMap[group] || 0) <= 4); %>
  <% const criticalRequests = requests.filter(r => (r.emergencyLevel || '').toLowerCase() === 'critical').length; %>
  <% const urgentRequests = requests.filter(r => (r.emergencyLevel || '').toLowerCase() === 'urgent').length; %>
  <% const fulfilledRequests = requests.filter(r => (r.status || '').toLowerCase() === 'fulfilled').length; %>

  <nav class="navbar">
    <div class="logo"><span class="logo-text">🩸 RedConnect</span></div>
    <div class="nav-buttons">
      <a href="/hospital/logout"><button class="appointment-btn">Logout</button></a>
    </div>
  </nav>

  <div class="admin-wrapper hospital-dashboard-shell">
    <div class="hospital-hero">
      <div class="hospital-hero-copy">
        <div class="hospital-kicker">Hospital command center</div>
        <h1>🏥 <%= hospital.name %></h1>
        <p>Monitor stock, broadcast emergencies, and close fulfilled requests from one live dashboard.</p>
        <div class="hospital-hero-meta">
          <span>📍 <%= hospital.address %>, <%= hospital.city %></span>
          <span>📞 <%= hospital.phone %></span>
          <span>✅ Verified hospital</span>
        </div>
      </div>
      <div class="hospital-hero-rail">
        <div class="hospital-rail-title">Live overview</div>
        <div class="hospital-rail-list">
          <div class="hospital-rail-item"><span>Open requests</span><strong><%= requests.length %></strong></div>
          <div class="hospital-rail-item"><span>Critical cases</span><strong><%= criticalRequests %></strong></div>
          <div class="hospital-rail-item"><span>Urgent cases</span><strong><%= urgentRequests %></strong></div>
          <div class="hospital-rail-item"><span>Fulfilled today</span><strong><%= fulfilledRequests %></strong></div>
        </div>
      </div>
    </div>

    <div class="hospital-summary-grid">
      <div class="hospital-summary-card is-red">
        <div class="hospital-summary-label">Open requests</div>
        <div class="hospital-summary-value"><%= requests.length %></div>
        <div class="hospital-summary-note">Requests waiting for follow-up</div>
      </div>
      <div class="hospital-summary-card is-orange">
        <div class="hospital-summary-label">Critical alerts</div>
        <div class="hospital-summary-value"><%= criticalRequests %></div>
        <div class="hospital-summary-note">Needs immediate donor action</div>
      </div>
      <div class="hospital-summary-card is-green">
        <div class="hospital-summary-label">Inventory units</div>
        <div class="hospital-summary-value"><%= totalUnits %></div>
        <div class="hospital-summary-note"><%= lowStockGroups.length %> blood groups are low</div>
      </div>
      <div class="hospital-summary-card is-blue">
        <div class="hospital-summary-label">Pending donor checks</div>
        <div class="hospital-summary-value"><%= donations.length %></div>
        <div class="hospital-summary-note">Awaiting screening verification</div>
      </div>
    </div>

    <div class="hospital-dashboard-grid">
      <div class="hospital-panel">
        <div class="hospital-panel-header">
          <div>
            <h3>🚨 Create Emergency Request</h3>
            <div class="hospital-panel-subtitle">Send a broadcast request and notify nearby donors instantly.</div>
          </div>
          <span class="hospital-panel-badge">Live form</span>
        </div>

        <form id="emergencyForm" class="hospital-form-grid">
          <div class="form-group">
            <label>Patient Name</label>
            <input type="text" name="patientName" required placeholder="Patient full name">
          </div>
          <div class="form-group">
            <label>Blood Group Required</label>
            <select name="bloodGroup" required onchange="showBloodStock(this.value)">
              <option value="">Select</option>
              <% inventoryGroups.forEach(g => { %>
                <option value="<%= g %>"><%= g %></option>
              <% }) %>
            </select>
          </div>
          <div id="stockInfo" class="hospital-stock-note" style="display:none;">
            <strong>Current stock:</strong> <span id="stockVal"></span>
          </div>
          <div class="form-group">
            <label>Emergency Level</label>
            <select name="emergencyLevel" required>
              <option value="Normal">Normal</option>
              <option value="Urgent">Urgent</option>
              <option value="Critical">Critical</option>
            </select>
          </div>
          <div class="form-group">
            <label>Patient Age</label>
            <input type="number" name="patientAge" placeholder="Age (optional)">
          </div>
          <div class="form-group">
            <label>Contact Phone</label>
            <input type="tel" name="contactPhone" required placeholder="Contact number">
          </div>
          <button type="submit" class="h-submit-btn">🚨 Broadcast Emergency Request</button>
        </form>

        <div id="emergencyResult" class="hospital-result-box" style="display:none;"></div>
      </div>

      <div class="hospital-panel">
        <div class="hospital-panel-header">
          <div>
            <h3>🩸 Blood Inventory</h3>
            <div class="hospital-panel-subtitle">Update stock levels and spot low supply before the next emergency.</div>
          </div>
          <span class="hospital-panel-badge">8 groups</span>
        </div>

        <div class="inventory-group-grid">
          <% inventoryGroups.forEach(g => { %>
            <% const units = inventoryMap[g] || 0; %>
            <% const safeKey = g.replace('+','plus').replace('-','minus'); %>
            <div class="inventory-group-card <%= units <= 4 ? 'low' : '' %>" id="inv-row-<%= safeKey %>">
              <div class="inventory-group-top">
                <span class="blood-tag"><%= g %></span>
                <span class="inventory-group-units"><%= units %> units</span>
              </div>
              <div class="inv-bar-wrap">
                <div class="inv-bar" style="width:<%= Math.min(units * 5, 100) %>%"></div>
              </div>
              <div class="inventory-group-actions">
                <input type="number" id="inv-<%= g %>" value="<%= units %>" min="0" class="inv-input">
                <button class="inv-update-btn" onclick="updateInventory('<%= g %>')">Save</button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="admin-card admin-full-width hospital-panel request-panel">
        <div class="hospital-panel-header">
          <div>
            <h3>📋 Recent Blood Requests</h3>
            <div class="hospital-panel-subtitle">Track request status and mark fulfilled cases once care is complete.</div>
          </div>
        </div>
        <% if (requests.length === 0) { %>
          <div class="request-empty-state">No requests yet.</div>
        <% } else { %>
          <div class="request-table-wrap">
            <table class="mini-table hospital-request-table">
              <thead>
                <tr>
                  <th>Patient</th>
                  <th>Blood</th>
                  <th>Level</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(r => { %>
                  <tr id="req-<%= r._id %>">
                    <td><%= r.patientName %></td>
                    <td><span class="blood-tag"><%= r.bloodGroup %></span></td>
                    <td>
                      <span class="level-badge level-<%= (r.emergencyLevel || '').toLowerCase() %>">
                        <%= r.emergencyLevel %>
                      </span>
                    </td>
                    <td>
                      <span class="status-badge status-<%= (r.status || 'Pending').toLowerCase() %>">
                        <%= r.status || 'Pending' %>
                      </span>
                    </td>
                    <td><%= new Date(r.createdAt).toLocaleDateString() %></td>
                    <td>
                      <% if (r.status !== 'Fulfilled') { %>
                        <button class="admin-btn-verify" onclick="fulfillRequest('<%= r._id %>')">
                          ✅ Mark Fulfilled
                        </button>
                      <% } else { %>
                        <span class="request-status-muted">✅ Done</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.emit('join_hospital', '<%= hospital._id %>');

    // Show current stock when blood group is selected
    const inventory = <%- JSON.stringify(hospital.inventory || []) %>;
    function showBloodStock(group) {
      const stockInfo = document.getElementById('stockInfo');
      const stockVal  = document.getElementById('stockVal');
      if (!group) { stockInfo.style.display = 'none'; return; }
      const item  = inventory.find(i => i.bloodGroup === group);
      const units = item ? item.units : 0;
      stockVal.textContent = `${units} units of ${group} available in your hospital`;
      stockInfo.style.display = 'block';
      stockInfo.style.borderLeftColor = units === 0 ? '#e74c3c' : '#27ae60';
      stockInfo.style.background      = units === 0 ? '#ffebee' : '#e8f5e9';
    }

    // Emergency form submit
    document.getElementById('emergencyForm').addEventListener('submit', async e => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target));
      const r    = await fetch('/hospital/emergency', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
      });
      const res = await r.json();
      const el  = document.getElementById('emergencyResult');
      el.style.display = 'block';
      if (res.success) {
        el.style.background = '#e8f5e9';
        el.style.color = '#27ae60';
        el.style.border = '1px solid #27ae60';
        el.textContent = `✅ Request created! ${res.notifiedDonors} donors notified.`;
        e.target.reset();
      } else {
        el.style.background = '#ffebee';
        el.style.color = '#e74c3c';
        el.style.border = '1px solid #e74c3c';
        el.textContent = `❌ Error: ${res.error}`;
      }
    });

    // Update inventory with visual feedback
    async function updateInventory(bloodGroup) {
      const units = document.getElementById(`inv-${bloodGroup}`).value;
      const key   = bloodGroup.replace('+','plus').replace('-','minus');
      const r = await fetch('/hospital/inventory', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bloodGroup, units })
      });
      const res = await r.json();
      if (res.success) {
        // Update display text
        document.getElementById(`display-${key}`).textContent = `${units} units`;
        // Update bar width
        const bar = document.querySelector(`#inv-row-${key} .inv-bar`);
        if (bar) bar.style.width = Math.min(units * 5, 100) + '%';
        // Flash green
        const row = document.getElementById(`inv-row-${key}`);
        row.style.background = '#e8f5e9';
        setTimeout(() => row.style.background = '', 1500);
      }
    }

    // Mark request as fulfilled — removes from queue
    async function fulfillRequest(requestId) {
      if (!confirm('Mark this request as fulfilled? It will be removed from the queue.')) return;
      const r = await fetch(`/hospital/fulfill/${requestId}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) {
        const row = document.getElementById(`req-${requestId}`);
        if (row) {
          row.querySelector('td:nth-child(4)').innerHTML = '<span class="status-badge status-fulfilled">Fulfilled</span>';
          row.querySelector('td:last-child').innerHTML   = '<span style="color:#27ae60;font-size:13px;">✅ Done</span>';
        }
      }
    }
  </script>
</body>
</html>