<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donor Dashboard - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/request-system.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="quote-section">
    <h2>"Your Blood, Their Hope"</h2>
    <p>Browse active blood requests and respond to save lives.</p>
  </div>

  <div class="content-wrapper">
    <div class="faq-section">
      <h3>Donor Dashboard Help</h3>

      <div class="faq-item">
        <div class="faq-question" onclick="toggleFaq(this)">
          <h4>Live notifications</h4>
          <span class="arrow">▼</span>
        </div>
        <div class="faq-answer">
          <p>When a nearby blood request matches your group, you'll see a real-time alert on this page.</p>
        </div>
      </div>
    </div>

    <div class="register-container dashboard-page">
      <div class="register-header">
        <h1>🩸 Donor Dashboard</h1>
        <p>Welcome back, <%= user.name %></p>
        <div class="role-switcher">
          <a href="/requester/dashboard" class="role-btn">Switch to Requester Dashboard →</a>
        </div>
      </div>

      <div class="dash-card availability-card">
        <div class="card-title-row">
          <div>
            <h3>Availability for Emergency Requests</h3>
            <p class="muted">Toggle your availability and let hospitals reach you faster.</p>
          </div>
          <label class="availability-switch">
            <input type="checkbox" id="availabilityToggle" <%= donorProfile?.availability !== false ? 'checked' : '' %>>
            <span>Available now</span>
          </label>
        </div>
        <div class="availability-form">
          <label for="availabilityNote">Short note</label>
          <textarea id="availabilityNote" rows="2" placeholder="I am available after 6pm or near Sector 15."><%= donorProfile?.availabilityNote || '' %></textarea>
          <p id="availabilityStatus" class="subtle-note">Your current status is visible to requesters and hospitals.</p>
        </div>
      </div>

      <div class="dash-card full-width donor-feed-card">
        <div class="section-head-row">
          <div>
            <h3>Donor Requests Feed</h3>
            <p class="muted">Browse active blood donation requests, ranked by compatibility and urgency.</p>
          </div>
          <div class="feed-summary-row">
            <div class="feed-summary-chip"><strong id="feedSummaryTotal"><%= requestSummary?.total || 0 %></strong><span>Open</span></div>
            <div class="feed-summary-chip"><strong id="feedSummaryCompatible"><%= requestSummary?.compatible || 0 %></strong><span>Compatible</span></div>
            <div class="feed-summary-chip"><strong id="feedSummaryCritical"><%= requestSummary?.critical || 0 %></strong><span>Critical</span></div>
          </div>
        </div>

        <p id="donor-feed-status" class="subtle-note feed-status" aria-live="polite"></p>

        <div class="feed-toolbar" id="donor-feed-toolbar">
          <label class="feed-check">
            <input type="checkbox" id="compatibleOnlyFilter">
            <span>Show only compatible requests</span>
          </label>
          <div class="feed-select-wrap">
            <label for="urgencyFilter">Urgency</label>
            <select id="urgencyFilter">
              <option value="all">All urgencies</option>
              <option value="Critical">Critical</option>
              <option value="Urgent">Urgent</option>
              <option value="Normal">Normal</option>
            </select>
          </div>
        </div>

        <div
          id="donor-requests-feed"
          class="donor-feed-grid"
          data-feed-endpoint="/donor/api/requests"
          data-respond-endpoint-template="/donor/request/__ID__/respond"
          data-view-endpoint-template="/donor/request/__ID__"
          data-empty-message="No matching requests available right now."
        >
          <% if (!requestFeed || requestFeed.length === 0) { %>
            <div class="empty-state donor-feed-empty">No matching requests available right now.</div>
          <% } else { %>
            <% requestFeed.forEach(request => { %>
              <article class="request-card donor-feed-request <%= request.isCompatible ? 'compatible' : 'incompatible' %> <%= request.emergencyLevel.toLowerCase() %>">
                <div class="request-card-header">
                  <div>
                    <h3><%= request.patientName %></h3>
                    <div class="request-meta">
                      <span class="blood-pill"><%= request.bloodGroupRequired %></span>
                      <span class="urgency-pill <%= request.emergencyLevel.toLowerCase() %>"><%= request.emergencyLevel %></span>
                      <span class="compat-badge <%= request.compatibilityTone %>"><%= request.compatibilityLabel %></span>
                    </div>
                  </div>
                  <span class="priority-tag <%= request.emergencyLevel.toLowerCase() %>"><%= request.priorityLabel %></span>
                </div>
                <div class="request-card-body">
                  <div class="request-detail-grid">
                    <div>
                      <span class="detail-label">Location</span>
                      <strong><%= request.city %><%= request.area ? ' · ' + request.area : '' %></strong>
                    </div>
                    <div>
                      <span class="detail-label">Requested</span>
                      <strong><%= new Date(request.createdAt).toLocaleString() %></strong>
                    </div>
                  </div>
                  <% if (request.additionalMessage) { %>
                    <p class="subtle-note"><%= request.additionalMessage %></p>
                  <% } %>
                  <div class="request-actions donor-feed-actions">
                    <a href="/donor/request/<%= request.requestId %>" class="btn-secondary">View Details</a>
                    <% if (request.isCompatible && !request.hasResponded) { %>
                      <button type="button" class="btn-primary request-respond-btn" data-request-id="<%= request.requestId %>">Respond</button>
                    <% } else if (request.hasResponded) { %>
                      <span class="response-pill accepted">Response sent</span>
                    <% } else { %>
                      <span class="response-pill pending">Not compatible</span>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          <% } %>
        </div>
      </div>

      <div class="dashboard-grid">
        <div class="dash-col">
          <div class="dash-card notifications-card">
            <div class="card-title-row">
              <h3>Notifications</h3>
              <a href="/donor/notifications" class="view-all">View All</a>
            </div>
            <% if (!notificationsWidget || notificationsWidget.length === 0) { %>
              <div class="empty-state compact">No notifications yet. Matching alerts and donation updates will appear here.</div>
            <% } else { %>
              <div class="notification-stack">
                <% notificationsWidget.forEach(item => { %>
                  <article class="notification-item <%= item.tone %>">
                    <div class="notification-icon"><%= item.icon %></div>
                    <div class="notification-copy">
                      <h4><%= item.title %></h4>
                      <p><%= item.message %></p>
                      <small><%= new Date(item.createdAt).toLocaleString() %></small>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </div>

          <a href="/" class="back-link">← Back to Home</a>
        </div>
      </div>

      <div class="dash-card full-width" style="margin-top:20px;">
        <div class="card-title-row">
          <h3>🏅 My Donation Certificates</h3>
        </div>
        <% if (!certificates || certificates.length === 0) { %>
          <div class="empty-state compact">No certificates yet. Certificates are issued after admin verifies your donation.</div>
        <% } else { %>
          <div class="history-stack">
            <% certificates.forEach(cert => { %>
              <article class="history-item" style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                  <h4 style="color:#c0392b;"><%= cert.certificateId %></h4>
                  <p><%= cert.hospital %> · <%= cert.city %></p>
                  <p style="font-size:12px;color:#aaa;">Donated: <%= new Date(cert.donatedAt).toLocaleDateString() %> · Issued: <%= new Date(cert.issuedAt).toLocaleDateString() %></p>
                </div>
                <a href="/generate-certificate/<%= cert._id %>" class="btn-primary" style="white-space:nowrap;">⬇ Download PDF</a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>

      <a href="/" class="back-link">← Back to Home</a>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <style>
    .availability-card { margin-bottom: 20px; }
    .availability-switch { display: flex; align-items: center; gap: 8px; font-weight: 700; color: #b42318; }
    .availability-form { display: grid; gap: 8px; margin-top: 12px; }
    .availability-form textarea { border: 1px solid #f2c7c4; border-radius: 10px; padding: 10px 12px; resize: vertical; min-height: 70px; }
    .availability-form label { font-weight: 600; color: #7a1f1a; }
  </style>

  <script>
    function toggleFaq(element) {
      element.parentElement.classList.toggle('active');
    }
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/dashboard/donor-requests-feed.js"></script>
  <script>
    const socket = io();
    socket.emit('join_donor', '<%= user._id %>');
    socket.on('notification', data => {
      const banner = document.createElement('div');
      banner.className = 'live-notif';
      banner.innerHTML = `<strong>${data.title || '🔔 Notification'}</strong><br>${data.message}`;
      document.body.appendChild(banner);
      setTimeout(() => banner.remove(), 5000);
    });

    const availabilityToggle = document.getElementById('availabilityToggle');
    const availabilityNote = document.getElementById('availabilityNote');
    const availabilityStatus = document.getElementById('availabilityStatus');

    if (availabilityToggle && availabilityNote) {
      const saveAvailability = async () => {
        availabilityStatus.textContent = 'Saving...';
        try {
          const response = await fetch('/donor/availability', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ available: availabilityToggle.checked, note: availabilityNote.value })
          });
          const data = await response.json();
          if (data.success) {
            availabilityStatus.textContent = availabilityToggle.checked
              ? 'You are now visible for emergency requests.'
              : 'You are currently marked unavailable.';
          } else {
            availabilityStatus.textContent = data.error || 'Could not update availability.';
          }
        } catch (err) {
          availabilityStatus.textContent = 'Network error while updating availability.';
        }
      };

      availabilityToggle.addEventListener('change', saveAvailability);
      availabilityNote.addEventListener('change', saveAvailability);
    }
  </script>
</body>
</html>
