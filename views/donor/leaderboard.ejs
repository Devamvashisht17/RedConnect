<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaderboard - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="dashboard-wrapper">
    <div class="page-header">
      <h1>🏆 Donor Leaderboard</h1>
      <p>Top blood donors saving lives in our community</p>
    </div>

    <div class="leaderboard-table-wrap">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Donor</th>
            <th>Level</th>
            <th>Donations</th>
            <th>Points</th>
            <th>Lives Saved</th>
            <th>Badges</th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.forEach((entry, i) => { %>
            <tr class="<%= entry.user?._id?.toString() === user._id?.toString() ? 'my-row' : '' %>">
              <td>
                <% if (i === 0) { %> 🥇
                <% } else if (i === 1) { %> 🥈
                <% } else if (i === 2) { %> 🥉
                <% } else { %> #<%= i+1 %>
                <% } %>
              </td>
              <td>
                <div class="donor-name-cell">
                  <% if (entry.user?.profilePic) { %>
                    <img src="<%= entry.user.profilePic %>" class="mini-avatar">
                  <% } else { %>
                    <div class="mini-avatar-letter"><%= (entry.user?.name || '?').charAt(0) %></div>
                  <% } %>
                  <%= entry.user?.name || 'Unknown' %>
                </div>
              </td>
              <td><span class="level-badge level-<%= entry.donorLevel.toLowerCase() %>"><%= entry.donorLevel %></span></td>
              <td><%= entry.verifiedDonations %></td>
              <td><strong><%= entry.totalPoints %></strong></td>
              <td>❤️ <%= entry.livesSaved %></td>
              <td><%= entry.badges.map(b => b.icon).join(' ') || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
