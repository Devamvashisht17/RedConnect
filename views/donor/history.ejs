<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donation History - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/request-system.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="donor-history-page">
  <%- include('../partials/header') %>

  <main class="donor-history-shell">
    <section class="donor-history-hero">
      <article class="hero-card">
        <span class="hero-eyebrow">Donor History</span>
        <h1>Donation history</h1>
        <p>Review your verified donations, filter the records, and track your eligibility at a glance.</p>
        <div class="action-row">
          <a class="btn-primary" href="/donor/dashboard">Back to dashboard</a>
        </div>
      </article>

      <aside class="panel-card">
        <h2>Summary</h2>
        <div class="history-summary-grid">
          <div class="summary-chip"><div class="value"><%= summary.totalDonations %></div><div class="label">Total Donations</div></div>
          <div class="summary-chip"><div class="value"><%= summary.lastDonationDate ? new Date(summary.lastDonationDate).toLocaleDateString() : 'N/A' %></div><div class="label">Last Donation Date</div></div>
          <div class="summary-chip"><div class="value"><%= summary.nextEligibleDonationDate ? new Date(summary.nextEligibleDonationDate).toLocaleDateString() : 'Eligible now' %></div><div class="label">Next Eligible Donation Date</div></div>
          <div class="summary-chip"><div class="value"><%= summary.livesHelped %></div><div class="label">Lives Helped</div></div>
        </div>
      </aside>
    </section>

    <section class="panel-card" style="margin-bottom:24px;">
      <div class="section-title">
        <div>
          <h2>Filter Donation Records</h2>
          <p class="subtle-note">Newest records appear first.</p>
        </div>
      </div>

      <form method="GET" class="history-filter-bar">
        <div class="history-filter-fields">
          <div class="form-field">
            <label for="year">Year</label>
            <select name="year" id="year">
              <option value="all" <%= selectedYear === 'all' ? 'selected' : '' %>>All years</option>
              <% historyYears.forEach(year => { %>
                <option value="<%= year %>" <%= selectedYear === String(year) ? 'selected' : '' %>><%= year %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-field">
            <label for="status">Status</label>
            <select name="status" id="status">
              <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All statuses</option>
              <option value="completed" <%= selectedStatus === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="scheduled" <%= selectedStatus === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
              <option value="cancelled" <%= selectedStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
        </div>
        <div class="action-row" style="margin-top:0;">
          <button type="submit" class="btn-primary">Apply Filters</button>
          <a href="/donor/history" class="btn-secondary">Reset</a>
        </div>
      </form>
    </section>

    <section class="panel-card">
      <div class="section-title">
        <div>
          <h2>Donation Records</h2>
          <p class="subtle-note">Each card shows one donation record from newest to oldest.</p>
        </div>
      </div>

      <% if (!donations || donations.length === 0) { %>
        <div class="empty-state">You haven't donated blood yet.</div>
      <% } else { %>
        <div class="history-stack">
          <% donations.forEach(donation => { %>
            <article class="history-item">
              <div class="history-item-top">
                <div>
                  <h4><%= new Date(donation.donatedAt).toLocaleDateString() %></h4>
                  <p><%= donation.hospital %> · <%= donation.city %></p>
                </div>
                <span class="history-status <%= donation.statusTone %>"><%= donation.statusLabel %></span>
              </div>
              <div class="history-meta-grid">
                <div><span>Blood Group</span><strong><%= donation.bloodGroup %></strong></div>
                <div><span>Donation Type</span><strong><%= donation.donationType %></strong></div>
                <div><span>Recipient</span><strong><%= donation.recipientName %></strong></div>
                <div><span>Request ID</span><strong><%= donation.requestLabel || '—' %></strong></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
