<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donor Notifications - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/request-system.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="donor-notifications-page">
  <%- include('../partials/header') %>

  <main class="notifications-shell">
    <section class="notifications-hero">
      <article class="hero-card">
        <span class="hero-eyebrow">Donor Notifications</span>
        <h1>Updates that need your attention</h1>
        <p>Review donation alerts, response updates, and compatible blood requests from one place.</p>
        <div class="action-row">
          <a class="btn-primary" href="/donor/dashboard">Back to dashboard</a>
          <a class="btn-secondary" href="/donor/history">View donation history</a>
        </div>
      </article>

      <aside class="panel-card">
        <h2>Inbox summary</h2>
        <div class="stack-list">
          <div class="summary-chip"><div class="value"><%= notifications.length %></div><div class="label">Notifications</div></div>
          <div class="summary-chip"><div class="value"><%= requestOffers.length %></div><div class="label">Compatible requests</div></div>
          <div class="summary-chip"><div class="value"><%= donorProfile ? donorProfile.city : 'N/A' %></div><div class="label">Donor city</div></div>
        </div>
      </aside>
    </section>

    <section class="panel-card" style="margin-bottom:24px;">
      <div class="section-title">
        <div>
          <h2>Recent notifications</h2>
          <p class="subtle-note">Donation verification, matching alerts, reminders, and response updates.</p>
        </div>
      </div>

      <% if (!notifications || notifications.length === 0) { %>
        <div class="empty-state">No notifications yet. Matching alerts will appear here automatically.</div>
      <% } else { %>
        <div class="notification-stack">
          <% notifications.forEach(notification => { %>
            <article class="notification-item <%= notification.tone || 'neutral' %>">
              <div class="notification-icon"><%= notification.icon %></div>
              <div class="notification-copy">
                <h4><%= notification.title %></h4>
                <p><%= notification.message %></p>
                <small><%= new Date(notification.createdAt).toLocaleString() %></small>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="panel-card">
      <div class="section-title">
        <div>
          <h2>Compatible requests</h2>
          <p class="subtle-note">Requests that match your blood group and are ready for action.</p>
        </div>
      </div>

      <% if (!requestOffers || requestOffers.length === 0) { %>
        <div class="empty-state">No active requests are currently assigned to you.</div>
      <% } else { %>
        <div class="donor-offer-grid">
          <% requestOffers.forEach(request => { %>
            <article class="request-card donor-feed-request <%= request.emergencyLevel.toLowerCase() %>">
              <div class="request-card-header">
                <div>
                  <h3><%= request.patientName %></h3>
                  <div class="request-meta">
                    <span class="blood-pill"><%= request.bloodGroupRequired %></span>
                    <span class="urgency-pill <%= request.emergencyLevel.toLowerCase() %>"><%= request.emergencyLevel %></span>
                    <span class="compat-badge <%= request.compatibilityTone %>"><%= request.compatibilityLabel %></span>
                  </div>
                </div>
                <span class="priority-tag <%= request.emergencyLevel.toLowerCase() %>"><%= request.priorityLabel %></span>
              </div>
              <div class="request-card-body">
                <div class="request-detail-grid">
                  <div><span class="detail-label">Location</span><strong><%= request.city %><%= request.area ? ' · ' + request.area : '' %></strong></div>
                  <div><span class="detail-label">Request Time</span><strong><%= new Date(request.createdAt).toLocaleString() %></strong></div>
                </div>
                <div class="request-actions donor-feed-actions">
                  <a href="/donor/request/<%= request.requestId %>" class="btn-secondary">View Details</a>
                  <% if (request.isCompatible && !request.hasResponded) { %>
                    <form method="POST" action="/donor/request/<%= request.requestId %>/respond" class="inline-form">
                      <button type="submit" class="btn-primary">Respond</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>