      <h4>Subscribe Us</h4>
      <p>Get updates about blood donation campaigns and health tips.</p>
      <form class="subscribe-form" id="subscribeForm">
        <input type="email" id="subscribeEmail" placeholder="Enter your email" required>
        <button type="submit">Subscribe Now</button>
      </form>
      <p id="subscribeMsg" style="margin-top:8px;font-size:13px;font-weight:600;"></p>
