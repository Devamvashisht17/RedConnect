<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>RedConnect</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">

  <link rel="stylesheet" href="/css/style.css?v=3">
  <link rel="stylesheet" href="/css/donation-process.css?v=3">
  <link rel="stylesheet" href="/css/volunteers.css?v=3">
  <link rel="stylesheet" href="/css/footer.css?v=3">
  <link rel="stylesheet" href="/css/donors-group.css?v=3">
  <link rel="stylesheet" href="/css/hospital.css?v=3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <style>
    .feedback-section {
      padding: 56px 20px 72px;
      background: linear-gradient(135deg, #fef2f2 0%, #fdecec 100%);
      font-family: 'Poppins', sans-serif;
    }.support-section{
    padding:100px 8%;
    background:#fff5f5;
    font-family:'Poppins',sans-serif;
}

.support-card{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:70px;
    align-items:center;

    background:#fff5f5;
}

.support-copy h2{
    margin:0 0 18px;
    font-size:48px;
    font-weight:700;
    line-height:1.1;
    color:#1f2937;
}

.support-copy .accent{
    color:#dc2626;
}

.support-copy p{
    margin-bottom:24px;
    font-size:16px;
    line-height:1.8;
    color:#4b5563;
}

.support-list{
    list-style:none;
    padding:0;
    margin:0 0 28px;
}

.support-list li{
    display:flex;
    align-items:flex-start;
    gap:12px;
    margin-bottom:14px;
    font-size:18px;
    color:#4b5563;
}

.support-list i{
    color:#22c55e;
    margin-top:5px;
}

.support-btn{
    display:inline-block;
    padding:14px 34px;
    border:2px solid #dc2626;
    border-radius:8px;
    color:#dc2626;
    text-decoration:none;
    font-weight:600;
    transition:.3s;
    background:#fff;
}

.support-btn:hover{
    background:#dc2626;
    color:#fff;
}

.support-media{
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 16px;
    overflow: hidden;
    background: #fae7e7;
}

.support-copy{
    background: #fae7e7;
}

.support-media video{
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
}
.support-section,
.support-card{
    background:#fff5f5;
}
    @media (max-width: 900px) {
      .support-card { gap: 40px; }
      .support-copy h2 { font-size: 36px; }
    }
    @media (max-width: 768px) {
      .support-section { padding: 48px 20px; }
      .support-card { grid-template-columns: 1fr; gap: 32px; }
      .support-copy { text-align: center; }
      .support-copy h2 { font-size: 28px; }
      .support-list li { justify-content: center; text-align: left; }
      .support-btn { display: block; width: fit-content; margin: 0 auto; }
      .support-media { width: 100%; border-radius: 12px; }
    }
    @media (max-width: 480px) {
      .support-section { padding: 36px 16px; }
      .support-copy h2 { font-size: 24px; }
    }
    .feedback-shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 32px;
      border-radius: 28px;
      background: rgba(255,255,255,0.82);
      box-shadow: 0 18px 50px rgba(180, 35, 24, 0.12);
      border: 1px solid #f7d7d3;
      backdrop-filter: blur(8px);
    }
    .feedback-heading {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 24px;
      text-align: center;
    }
    .feedback-heading h2 {
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      color: #b42318;
    }
    .feedback-heading p {
      margin: 0;
      font-size: 16px;
      color: #6b7280;
      line-height: 1.6;
    }
    .testimonial-swiper {
      padding: 8px 2px 42px;
    }
    .testimonial-card {
      min-height: 280px;
      padding: 30px 32px;
      border-radius: 24px;
      background: #ffffff;
      box-shadow: 0 15px 35px rgba(17, 24, 39, 0.08);
      border: 1px solid #f6d8d3;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }
    .swiper-slide-active .testimonial-card {
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 20px 45px rgba(180, 35, 24, 0.16);
    }
    .testimonial-badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      padding: 7px 12px;
      border-radius: 999px;
      background: #fff1ef;
      color: #b42318;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .testimonial-card h3 {
      margin: 0 0 10px;
      font-size: 22px;
      font-weight: 700;
      color: #111827;
    }
    .testimonial-card p {
      margin: 0 0 16px;
      font-size: 16px;
      line-height: 1.7;
      color: #4b5563;
    }
    .testimonial-stars {
      display: flex;
      gap: 4px;
      color: #ef4444;
      font-size: 16px;
      margin-bottom: 20px;
    }
    .testimonial-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
    }
    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ef4444, #b42318);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      box-shadow: 0 10px 20px rgba(180, 35, 24, 0.2);
    }
    .testimonial-name {
      font-size: 18px;
      font-weight: 700;
      color: #111827;
    }
    .testimonial-subtitle {
      font-size: 13px;
      color: #6b7280;
      margin-top: 2px;
    }
    .testimonial-swiper .swiper-pagination {
      bottom: 6px;
    }
    .testimonial-swiper .swiper-pagination-bullet {
      width: 10px;
      height: 10px;
      background: #f6c5bf;
      opacity: 1;
      transition: all 0.3s ease;
    }
    .testimonial-swiper .swiper-pagination-bullet-active {
      width: 28px;
      border-radius: 999px;
      background: #ef4444;
    }
    @media (max-width: 768px) {
      .feedback-shell { padding: 22px; }
      .testimonial-card { min-height: 260px; padding: 24px; }
    }

    /* ── MOBILE COMPACT ── */
    @media (max-width: 768px) {
      /* Impact section */
      .impact-section { padding: 28px 16px; }
      .impact-header { margin-bottom: 20px; }
      .impact-header h2 { font-size: 22px; margin-bottom: 6px; }
      .impact-header p { font-size: 13px; }
      .impact-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .impact-card { padding: 14px 10px; border-radius: 10px; }
      .impact-icon { width: 36px; height: 36px; font-size: 16px; margin-bottom: 8px; }
      .impact-number { font-size: 26px; margin-bottom: 6px; }
      .impact-card h3 { font-size: 13px; margin-bottom: 4px; }
      .impact-card p { font-size: 12px; line-height: 1.4; }

      /* Donation process */
      .donation-header { padding: 16px 16px 10px; }
      .donation-header h2 { font-size: 18px; letter-spacing: 1px; }
      .donation-header p { display: none; }
      .divider { margin: 8px 0; }
      .donation-process { padding: 4px 0 16px; }
      .steps { grid-template-columns: 1fr 1fr; gap: 8px; }
      .step-image { display: none; }
      .step-number { position: static; width: 24px; height: 24px; font-size: 12px; margin: 8px auto 2px; }
      .step h3 { font-size: 13px; margin: 4px 0 4px; }
      .step ul { padding: 0 8px 8px; }
      .step ul li { font-size: 10px; margin-bottom: 2px; line-height: 1.3; }

      /* Find donors */
      .find-donors-section { padding: 24px 16px; }
      .find-donors-header h2 { font-size: 20px; margin-bottom: 6px; }
      .find-donors-header p { font-size: 13px; }
      .donors-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; }
      .donor-card { padding: 12px 8px; border-radius: 10px; }
      .donor-badge { font-size: 14px; width: 40px; height: 40px; margin-bottom: 6px; }
      .donor-card h3 { font-size: 11px; margin-bottom: 2px; }
      .donor-count { font-size: 11px; }
      .find-btn { font-size: 11px; }
      .compat-guide-btn { margin-top: 14px; }

      /* Hospital section */
      .hospital-section { padding: 24px 16px; }
      .hospital-header { margin-bottom: 20px; }
      .hospital-header h2 { font-size: 20px; margin-bottom: 6px; }
      .hospital-header p { font-size: 13px; }
      .hospital-cards { gap: 12px; }
      .hospital-card { padding: 20px 16px 18px; }
      .hospital-card-icon { font-size: 32px; margin-bottom: 10px; }
      .hospital-card h3 { font-size: 16px; margin-bottom: 8px; }
      .hospital-card p { font-size: 13px; line-height: 1.5; margin-bottom: 16px; }

      /* Support section */
      .support-section { padding: 28px 16px; }
      .support-copy h2 { font-size: 22px; margin-bottom: 12px; }
      .support-copy p { font-size: 13px; line-height: 1.6; margin-bottom: 14px; }
      .support-list li { font-size: 13px; margin-bottom: 8px; }
      .support-media { display: none; }

      /* Feedback section */
      .feedback-section { padding: 28px 16px 36px; }
      .feedback-heading h2 { font-size: 20px; }
      .feedback-heading p { font-size: 13px; }
      .testimonial-card { min-height: auto; padding: 18px; }
      .testimonial-card h3 { font-size: 15px; }
      .testimonial-card p { font-size: 13px; }
    }
  </style>

  <!-- REDESIGNED HERO SECTION -->
  <section class="hero">
    <div class="hero-container">
      <!-- Left: Text Content -->
      <div class="hero-text">
        <h1>Every Drop Can<br><span class="highlight-red">Save a Life</span></h1>
        <h2 class="hero-subheading">Connect blood donors with patients in need quickly, securely, and efficiently.</h2>
        <p class="hero-description">
          Join thousands of donors helping save lives every day. Whether you need blood urgently or want to become a donor, RedConnect makes the process simple, secure, and fast.
        </p>
        <div class="hero-buttons">
          <button class="hero-btn primary-btn" onclick="window.location.href='/request'"><i class="fa-solid fa-droplet" aria-hidden="true"></i>&nbsp;Find Blood</button>
          <button class="hero-btn secondary-btn" onclick="window.location.href='/register'"><i class="fa-solid fa-users" aria-hidden="true"></i>&nbsp;Become a Donor</button>
        </div>
      </div>

      <!-- Right: Hero Image -->
      <div class="hero-image-wrapper">
        <img 
          src="/images/hero_donors.jpeg" 
          alt="Blood donors and medical staff helping donors"
          class="hero-image"
        >
      </div>
    </div>
  </section>

  <!-- LIVE IMPACT STATISTICS -->
  <section class="impact-section" id="impact-statistics">
    <div class="impact-container">
      <div class="impact-header">
        <h2>Our Impact</h2>
        <p>Together, our community is saving lives every day through blood donation.</p>
      </div>

      <div class="impact-grid">
        <article class="impact-card" data-target="<%= impactStats?.registeredDonors || 0 %>">
          <div class="impact-icon"><i class="fa-solid fa-heart" aria-hidden="true"></i></div>
          <div class="impact-number"><span class="counter">0</span>+</div>
          <h3>Registered Donors</h3>
          <p>People ready to donate blood anytime.</p>
        </article>

        <article class="impact-card" data-target="<%= impactStats?.successfulDonations || 0 %>">
          <div class="impact-icon"><i class="fa-solid fa-tint" aria-hidden="true"></i></div>
          <div class="impact-number"><span class="counter">0</span>+</div>
          <h3>Successful Donations</h3>
          <p>Lives supported through blood donation.</p>
        </article>

        <article class="impact-card" data-target="<%= impactStats?.partnerHospitals || 0 %>">
          <div class="impact-icon"><i class="fa-solid fa-hospital" aria-hidden="true"></i></div>
          <div class="impact-number"><span class="counter">0</span>+</div>
          <h3>Partner Hospitals</h3>
          <p>Hospitals and blood banks connected.</p>
        </article>

        <article class="impact-card" data-target="<%= impactStats?.citiesCovered || 0 %>">
          <div class="impact-icon"><i class="fa-solid fa-globe" aria-hidden="true"></i></div>
          <div class="impact-number"><span class="counter">0</span>+</div>
          <h3>Cities Covered</h3>
          <p>Growing network across multiple cities.</p>
        </article>
      </div>
    </div>
  </section>

  <%- include('donation-process') %>

  <!-- FIND DONORS SECTION -->
  <section class="find-donors-section">
    <div class="find-donors-header">
      <h2>Find Donors by Blood Group</h2>
      <p>Discover available donors for each blood type in your area</p>
    </div>
    <div class="donors-grid">
      <% const cardColors = {'O+':'#e53935','A+':'#8e24aa','B+':'#1e88e5','AB+':'#00897b','O-':'#f4511e','A-':'#6d4c41','B-':'#3949ab','AB-':'#00acc1'}; %>
      <% bloodGroups.forEach(group => { %>
        <a href="/donors/<%= encodeURIComponent(group) %>" class="donor-card">
          <div class="donor-badge" style="background-color: <%= cardColors[group] %>;">
            <%= group %>
          </div>
          <h3><%= group %> Blood Group</h3>
          <p class="donor-count"><%= counts[group] || 0 %> donors available</p>
          <span class="find-btn">Find Donors →</span>
        </a>
      <% }) %>
    </div>
    <div class="compat-guide-btn">
      <a href="/blood" class="compat-btn">Blood Compatibility Guide</a>
    </div>
  </section>

  <!-- HOSPITAL / BLOOD BANK SECTION -->
  <section class="hospital-section">
    <div class="hospital-header">
      <h2>Are You a Hospital or Blood Bank?</h2>
      <p>Join RedConnect's network to manage blood inventory, post emergency requests and connect with donors instantly.</p>
    </div>
    <div class="hospital-cards">
      <div class="hospital-card">
        <div class="hospital-card-icon">🏥</div>
        <h3>Register Your Hospital</h3>
        <p>Onboard your hospital to access real-time donor database, manage blood inventory and broadcast emergency requests.</p>
        <a href="/hospital/register" class="hospital-card-btn">Register Now</a>
      </div>
      <div class="hospital-card">
        <div class="hospital-card-icon">🔍</div>
        <h3>Already Registered?</h3>
        <p>Login to your hospital dashboard to manage blood requests, update inventory and connect with nearby donors.</p>
        <a href="/hospital/login" class="hospital-card-btn outline">Hospital Login</a>
      </div>
      <div class="hospital-card">
        <div class="hospital-card-icon">🚑</div>
        <h3>Emergency Requests</h3>
        <p>Broadcast critical blood requirements instantly to thousands of registered donors in your city.</p>
        <a href="/request" class="hospital-card-btn outline">Request Blood</a>
      </div>
    </div>
  </section>

  <section class="support-section" aria-labelledby="support-heading">
    <div class="support-card">
      <div class="support-copy">
        <h2 id="support-heading">Support Us Make <span class="accent">Blood Sufficient</span></h2>
        <p>Our mission is to ensure that no patient suffers due to a shortage of blood. With your support, we can expand our donor network, organize more blood donation camps, and strengthen emergency blood assistance across the country. Every contribution helps us save lives.</p>
        <ul class="support-list">
          <li><i class="fa-solid fa-check"></i> Arrange blood donors for patients in emergencies</li>
          <li><i class="fa-solid fa-check"></i> Conduct blood donation awareness campaigns</li>
          <li><i class="fa-solid fa-check"></i> Support regular blood requirements for thalassemia patients</li>
          <li><i class="fa-solid fa-check"></i> Expand our volunteer and donor network nationwide</li>
          <li><i class="fa-solid fa-check"></i> Help hospitals and blood banks during critical shortages</li>
        </ul>
        <div style="display:grid;gap:10px;max-width:360px;">
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <input id="donateName" type="text" placeholder="Your name" style="flex:1;min-width:130px;padding:10px 14px;border:2px solid #dc2626;border-radius:8px;font-size:14px;font-family:'Poppins',sans-serif;outline:none;">
            <input id="donateEmail" type="email" placeholder="Your email" style="flex:1;min-width:150px;padding:10px 14px;border:2px solid #dc2626;border-radius:8px;font-size:14px;font-family:'Poppins',sans-serif;outline:none;">
          </div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <select id="donateAmount" style="padding:10px 14px;border:2px solid #dc2626;border-radius:8px;font-size:15px;font-family:'Poppins',sans-serif;color:#1f2937;background:#fff;cursor:pointer;">
              <option value="50000">₹500</option>
              <option value="100000" selected>₹1,000</option>
              <option value="200000">₹2,000</option>
              <option value="500000">₹5,000</option>
            </select>
            <button id="donateBtn" class="support-btn" style="cursor:pointer;border:none;">❤️ Donate Now</button>
            <button id="volunteerBtn" class="support-btn" style="cursor:pointer;border:none;background:#dc2626;color:#fff;">🙋 Support Us</button>
          </div>
        </div>
        <p id="donateMsg" style="margin:8px 0 0;font-size:13px;color:#b42318;font-weight:600;"></p>
      </div>
      <div class="support-media" aria-label="Animated blood donation illustration">
        <video autoplay muted loop playsinline webkit-playsinline preload="auto" poster="/images/hero_donors.jpeg">
          <source src="/animations/support-animation.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </section>

  <section class="feedback-section">
    <div class="feedback-shell">
      <div class="feedback-heading">
        <h2>Testimonials & Feedback</h2>
        <p>Real stories from donors, volunteers, and families who trusted RedConnect during urgent moments.</p>
      </div>

      <div class="swiper testimonial-swiper">
        <div class="swiper-wrapper">
          <% testimonials.forEach((item) => { %>
            <div class="swiper-slide">
              <article class="testimonial-card">
                <div>
                  <div class="testimonial-badge">Trusted Experience</div>
                 
                  <h3>“<%= item.message %>”</h3>
                  <div class="testimonial-stars" aria-label="<%= item.rating %> star rating">
                    <% for (let i = 0; i < 5; i++) { %>
                      <i class="<%= i < item.rating ? 'fa-solid fa-star' : 'fa-regular fa-star' %>"></i>
                    <% } %>
                  </div>
                </div>
                <div class="testimonial-footer">
                  <div class="testimonial-avatar"><i class="fa-solid fa-kit-medical"></i></div>
                  <div>
                    <div class="testimonial-name"><%= item.name %></div>
                    <div class="testimonial-subtitle"><%= item.subtitle || 'Helpline Requester' %></div>
                  </div>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </section>

  <section class="feedback-section" style="padding-top: 0;">
    <div class="feedback-shell">
      <div class="feedback-heading" style="margin-bottom: 16px;">
        <h2 style="font-size: 24px;">Share your experience</h2>
        <p>Tell us what worked well or what we can improve for the next donation drive.</p>
      </div>

      <form id="feedbackForm" style="display: grid; gap: 14px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
          <input type="text" name="name" placeholder="Your name" required style="padding: 12px 14px; border: 1px solid #f4c2bb; border-radius: 14px; background: #fffaf7; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04); outline: none; font-size: 15px;">
          <input type="email" name="email" placeholder="Your email" required style="padding: 12px 14px; border: 1px solid #f4c2bb; border-radius: 14px; background: #fffaf7; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04); outline: none; font-size: 15px;">
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; align-items: end;">
          <div style="display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border: 1px solid #f4c2bb; border-radius: 14px; background: #fffaf7; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04);">
            <label for="ratingInput" style="font-weight: 700; color: #b42318;">Your rating</label>
            <div id="starRating" role="radiogroup" aria-label="Rate your experience" style="display: flex; gap: 6px;">
              <button type="button" class="feedback-star" data-value="1" aria-label="1 star" style="background: none; border: 0; padding: 0; font-size: 32px; color: #f4c2bb; cursor: pointer; line-height: 1; transition: transform 0.2s ease, color 0.2s ease;">☆</button>
              <button type="button" class="feedback-star" data-value="2" aria-label="2 stars" style="background: none; border: 0; padding: 0; font-size: 32px; color: #f4c2bb; cursor: pointer; line-height: 1; transition: transform 0.2s ease, color 0.2s ease;">☆</button>
              <button type="button" class="feedback-star" data-value="3" aria-label="3 stars" style="background: none; border: 0; padding: 0; font-size: 32px; color: #f4c2bb; cursor: pointer; line-height: 1; transition: transform 0.2s ease, color 0.2s ease;">☆</button>
              <button type="button" class="feedback-star" data-value="4" aria-label="4 stars" style="background: none; border: 0; padding: 0; font-size: 32px; color: #f4c2bb; cursor: pointer; line-height: 1; transition: transform 0.2s ease, color 0.2s ease;">☆</button>
              <button type="button" class="feedback-star" data-value="5" aria-label="5 stars" style="background: none; border: 0; padding: 0; font-size: 32px; color: #f4c2bb; cursor: pointer; line-height: 1; transition: transform 0.2s ease, color 0.2s ease;">☆</button>
            </div>
            <input type="hidden" name="rating" id="ratingInput" value="0" required>
          </div>
          <select name="category" style="padding: 12px 14px; border: 1px solid #f4c2bb; border-radius: 14px; background: #fffaf7; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04); outline: none; font-size: 15px; color: #374151;">
            <option value="general">General</option>
            <option value="donor">Donor experience</option>
            <option value="request">Blood request flow</option>
            <option value="hospital">Hospital support</option>
          </select>
        </div>
        <textarea name="message" rows="4" placeholder="Share your feedback..." required style="padding: 12px 14px; border: 1px solid #f4c2bb; border-radius: 14px; resize: vertical; background: #fffaf7; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04); outline: none; font-size: 15px; min-height: 110px;"></textarea>
        <button id="feedbackSubmit" type="submit" style="width: fit-content; padding: 12px 18px; border: 0; background: linear-gradient(135deg, #e53935, #b42318); color: white; border-radius: 999px; cursor: pointer; font-weight: 700; transition: all 0.2s ease; box-shadow: 0 8px 20px rgba(181, 35, 24, 0.2);">Submit Feedback</button>
        <p id="feedbackMessage" style="margin: 0; color: #0f766e; font-weight: 600;"></p>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="/js/home-stats.js?v=1" defer></script>
  <script>
    const feedbackForm = document.getElementById('feedbackForm');
    const feedbackMessage = document.getElementById('feedbackMessage');
    const ratingInput = document.getElementById('ratingInput');
    const feedbackSubmit = document.getElementById('feedbackSubmit');
    const starButtons = Array.from(document.querySelectorAll('.feedback-star'));

    if (window.Swiper) {
      new Swiper('.testimonial-swiper', {
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        speed: 700,
        grabCursor: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        pagination: {
          el: '.testimonial-swiper .swiper-pagination',
          clickable: true
        },
        breakpoints: {
          640: { slidesPerView: 1.2 },
          900: { slidesPerView: 1.5 },
          1200: { slidesPerView: 2 }
        }
      });
    }

    const updateRatingUI = (value) => {
      starButtons.forEach((button, index) => {
        const isActive = index < value;
        button.textContent = isActive ? '★' : '☆';
        button.style.color = isActive ? '#f59e0b' : '#f4c2bb';
        button.style.transform = isActive ? 'scale(1.08)' : 'scale(1)';
      });

      feedbackSubmit.style.background = value > 0
        ? 'linear-gradient(135deg, #fbbf24, #f59e0b)'
        : 'linear-gradient(135deg, #e53935, #b42318)';
      feedbackSubmit.style.color = value > 0 ? '#111827' : 'white';
    };

    starButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = Number(button.dataset.value);
        ratingInput.value = value;
        updateRatingUI(value);
      });
    });

    if (feedbackForm) {
      feedbackForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!ratingInput.value || Number(ratingInput.value) < 1) {
          feedbackMessage.textContent = 'Please select a star rating.';
          feedbackMessage.style.color = '#b42318';
          return;
        }

        const formData = new FormData(feedbackForm);
        feedbackMessage.textContent = 'Submitting...';
        feedbackMessage.style.color = '#0f766e';
        try {
          const response = await fetch('/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData.entries()))
          });
          const data = await response.json();
          feedbackMessage.textContent = data.message || data.error || 'Thank you.';
          feedbackMessage.style.color = response.ok ? '#0f766e' : '#b42318';
          if (response.ok) {
            feedbackForm.reset();
            ratingInput.value = '0';
            updateRatingUI(0);
          }
        } catch (err) {
          feedbackMessage.textContent = 'Unable to submit feedback right now.';
          feedbackMessage.style.color = '#b42318';
        }
      });
    }

    updateRatingUI(0);
  </script>

  <!-- Volunteer Modal -->
  <div id="volunteerModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.55);backdrop-filter:blur(3px);align-items:center;justify-content:center;padding:16px;">
    <div style="background:#fff;border-radius:20px;padding:32px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 24px 60px rgba(0,0,0,0.2);">
      <button id="volunteerModalClose" style="position:absolute;top:14px;right:18px;background:none;border:none;font-size:22px;cursor:pointer;color:#6b7280;line-height:1;">&#x2715;</button>
      <h2 style="margin:0 0 4px;font-size:22px;font-weight:700;color:#1f2937;">&#x1F64B; Become a Volunteer</h2>
      <p style="margin:0 0 20px;font-size:14px;color:#6b7280;">Join our mission to make blood sufficient for everyone.</p>
      <form id="volunteerModalForm" style="display:grid;gap:12px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <input type="text" name="name" placeholder="Full name *" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;outline:none;font-family:'Poppins',sans-serif;">
          <input type="email" name="email" placeholder="Email *" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;outline:none;font-family:'Poppins',sans-serif;">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <input type="tel" name="phone" placeholder="Phone *" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;outline:none;font-family:'Poppins',sans-serif;">
          <input type="number" name="age" placeholder="Age *" min="16" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;outline:none;font-family:'Poppins',sans-serif;">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <select name="city" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;color:#374151;background:#fff;font-family:'Poppins',sans-serif;">
            <option value="">Select City *</option>
            <option>Rajpura</option><option>Chandigarh</option><option>Patiala</option>
            <option>Mohali</option><option>Ludhiana</option><option>Amritsar</option>
          </select>
          <select name="availability" required style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;color:#374151;background:#fff;font-family:'Poppins',sans-serif;">
            <option value="">Availability *</option>
            <option value="Weekends">Weekends Only</option>
            <option value="Weekdays">Weekdays</option>
            <option value="Flexible">Flexible</option>
            <option value="Events">Events Only</option>
          </select>
        </div>
        <input type="text" name="skills" placeholder="Skills / Experience (optional)" style="padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;outline:none;font-family:'Poppins',sans-serif;">
        <button type="submit" id="volunteerSubmitBtn" style="padding:12px;background:#dc2626;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Poppins',sans-serif;">Register as Volunteer</button>
        <p id="volunteerModalMsg" style="margin:0;font-size:13px;font-weight:600;text-align:center;"></p>
      </form>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const donateBtn = document.getElementById('donateBtn');
    const donateMsg = document.getElementById('donateMsg');

    if (donateBtn) {
      donateBtn.addEventListener('click', async () => {
        const amount = parseInt(document.getElementById('donateAmount').value);
        const name   = document.getElementById('donateName').value.trim() || 'Anonymous';
        const email  = document.getElementById('donateEmail').value.trim();
        donateBtn.disabled = true;
        donateMsg.textContent = '';

        try {
          const res  = await fetch('/api/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Order creation failed.');

          const options = {
            key:         '<%- razorpayKeyId %>',
            amount:      data.amount,
            currency:    data.currency,
            name:        'RedConnect',
            description: 'Support Blood Donation Mission',
            order_id:    data.order_id,
            prefill:     { name, email },
            theme:       { color: '#d32f2f' },
            handler: async (response) => {
              try {
                const vRes = await fetch('/api/verify-payment', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ ...response, amount: data.amount, name, email })
                });
                const vData = await vRes.json();
                if (vRes.ok && vData.success) {
                  donateMsg.style.color = '#0f766e';
                  donateMsg.textContent = '🎉 Thank you for your donation! Payment ID: ' + vData.payment_id;
                } else {
                  donateMsg.style.color = '#b42318';
                  donateMsg.textContent = vData.error || 'Payment verification failed.';
                }
              } catch {
                donateMsg.style.color = '#b42318';
                donateMsg.textContent = 'Could not verify payment. Please contact support.';
              }
            },
            modal: {
              ondismiss: () => {
                donateMsg.style.color = '#6b7280';
                donateMsg.textContent = 'Payment cancelled.';
              }
            }
          };

          const rzp = new Razorpay(options);
          rzp.on('payment.failed', (response) => {
            donateMsg.style.color = '#b42318';
            donateMsg.textContent = 'Payment failed: ' + response.error.description;
          });
          rzp.open();
        } catch (err) {
          donateMsg.style.color = '#b42318';
          donateMsg.textContent = err.message || 'Something went wrong.';
        } finally {
          donateBtn.disabled = false;
        }
      });
    }
  </script>

  <script>
    const volunteerBtn         = document.getElementById('volunteerBtn');
    const volunteerModal       = document.getElementById('volunteerModal');
    const volunteerModalClose  = document.getElementById('volunteerModalClose');
    const volunteerModalForm   = document.getElementById('volunteerModalForm');
    const volunteerModalMsg    = document.getElementById('volunteerModalMsg');
    const volunteerSubmitBtn   = document.getElementById('volunteerSubmitBtn');

    volunteerBtn.addEventListener('click', () => {
      volunteerModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });

    function closeVolunteerModal() {
      volunteerModal.style.display = 'none';
      document.body.style.overflow = '';
      volunteerModalForm.reset();
      volunteerModalMsg.textContent = '';
    }

    volunteerModalClose.addEventListener('click', closeVolunteerModal);
    volunteerModal.addEventListener('click', (e) => { if (e.target === volunteerModal) closeVolunteerModal(); });

    volunteerModalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      volunteerSubmitBtn.disabled = true;
      volunteerSubmitBtn.textContent = 'Registering...';
      volunteerModalMsg.textContent = '';
      try {
        const data = Object.fromEntries(new FormData(volunteerModalForm).entries());
        const res  = await fetch('/volunteer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (res.ok && json.success) {
          volunteerModalMsg.style.color = '#0f766e';
          volunteerModalMsg.textContent = '🎉 Thank you, ' + json.name + '! We will be in touch soon.';
          volunteerModalForm.reset();
        } else {
          volunteerModalMsg.style.color = '#b42318';
          volunteerModalMsg.textContent = json.error || 'Registration failed. Please try again.';
        }
      } catch {
        volunteerModalMsg.style.color = '#b42318';
        volunteerModalMsg.textContent = 'Something went wrong. Please try again.';
      }
      volunteerSubmitBtn.disabled = false;
      volunteerSubmitBtn.textContent = 'Register as Volunteer';
    });
  </script>

</body>
</html>
