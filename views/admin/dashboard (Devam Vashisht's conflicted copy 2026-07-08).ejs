<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="quote-section">
    <h2>"Coordinate Care, Save Lives"</h2>
    <p>Verify donors after hospital screening, approve hospitals, and manage blood requests.</p>
  </div>

  <div class="content-wrapper">
    <div class="faq-section">
      <h3>Admin Guide</h3>

      <div class="faq-item">
        <div class="faq-question" onclick="toggleFaq(this)">
          <h4>Hospital approvals</h4>
          <span class="arrow">▼</span>
        </div>
        <div class="faq-answer">
          <p>New hospitals must be verified before they can submit blood requests on the platform.</p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question" onclick="toggleFaq(this)">
          <h4>Donor screening verification</h4>
          <span class="arrow">▼</span>
        </div>
        <div class="faq-answer">
          <p>When a blood request is submitted, compatible donors receive an email to come for doctor screening. After screening, click "Healthy — send emails" to notify the donor to give blood and the requester to receive blood.</p>
        </div>
      </div>
    </div>

    <div class="register-container dashboard-page">
      <div class="register-header">
        <h1>⚙️ Admin Dashboard</h1>
        <p>Manage the RedConnect emergency blood response system</p>
      </div>

      <div class="admin-stats-row">
        <div class="admin-stat-card" style="border-top:4px solid #e74c3c">
          <div class="admin-stat-icon" style="background:#fff0f0">👥</div>
          <div class="admin-stat-value"><%= totalUsers %></div>
          <div class="admin-stat-label">Total Users</div>
        </div>
        <div class="admin-stat-card" style="border-top:4px solid #27ae60">
          <div class="admin-stat-icon" style="background:#f0fff4">🩸</div>
          <div class="admin-stat-value"><%= totalDonors %></div>
          <div class="admin-stat-label">Total Donors</div>
        </div>
        <div class="admin-stat-card" style="border-top:4px solid #e67e22">
          <div class="admin-stat-icon" style="background:#fff8f0">📋</div>
          <div class="admin-stat-value"><%= openRequests %></div>
          <div class="admin-stat-label">Open Requests</div>
        </div>
        <div class="admin-stat-card" style="border-top:4px solid #2980b9">
          <div class="admin-stat-icon" style="background:#f0f8ff">🏥</div>
          <div class="admin-stat-value"><%= pendingHospitals.length %></div>
          <div class="admin-stat-label">Pending Hospitals</div>
        </div>
        <div class="admin-stat-card" style="border-top:4px solid #8e44ad">
          <div class="admin-stat-icon" style="background:#f9f0ff">🙋</div>
          <div class="admin-stat-value"><%= volunteerCount %></div>
          <div class="admin-stat-label">Volunteers</div>
        </div>
        <div class="admin-stat-card" style="border-top:4px solid #27ae60;cursor:pointer;" onclick="location.href='/admin/donations'">
          <div class="admin-stat-icon" style="background:#f0fff4">🩸</div>
          <div class="admin-stat-value"><%= pendingDonationsCount %></div>
          <div class="admin-stat-label">Pending Donations</div>
        </div>
      </div>

      <div class="admin-grid">

        <div class="admin-card admin-full-width">
          <div class="admin-card-header">
            <h3>⚠️ Low Rating Feedback (below 3 stars)</h3>
            <span class="admin-badge red"><%= lowRatingFeedback.length %></span>
          </div>
          <% if (lowRatingFeedback.length === 0) { %>
            <div class="admin-empty">✅ No low-rating feedback</div>
          <% } else { %>
            <% lowRatingFeedback.forEach(f => { %>
              <div class="admin-pending-item">
                <div class="admin-pending-info">
                  <strong><%= f.name %></strong>
                  <span class="admin-badge red" style="margin-left:8px;"><%= f.rating %> ★</span>
                  <div class="admin-pending-sub"><%= f.email %> &middot; <%= f.category %></div>
                  <div class="admin-pending-sub" style="margin-top:4px;">"<%= f.message %>"</div>
                  <div class="admin-pending-sub"><%= new Date(f.createdAt).toLocaleString() %></div>
                  <div class="admin-reply-form" style="margin-top:10px;display:flex;gap:8px;align-items:flex-start;">
                    <textarea id="reply-<%= f._id %>" rows="2" placeholder="Type your reply..." style="flex:1;border:1px solid #f2c7c4;border-radius:8px;padding:8px 10px;resize:vertical;"></textarea>
                    <button class="admin-btn-verify" onclick="replyFeedback('<%= f._id %>')" style="white-space:nowrap;">&#9993; Send Reply</button>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="admin-card admin-full-width">
          <div class="admin-card-header">
            <h3>🩺 Donors awaiting health screening verification</h3>
          </div>
          <div class="admin-empty">Donor screening is managed via the <a href="/admin/screening">Screening Dashboard</a>.</div>
        </div>

        <div class="admin-card">
          <div class="admin-card-header">
            <h3>🙋 Registered Volunteers</h3>
            <span class="admin-badge" style="background:#8e44ad;color:#fff"><%= volunteerCount %></span>
          </div>
          <% if (volunteers.length === 0) { %>
            <div class="admin-empty">No volunteers registered yet.</div>
          <% } else { %>
            <% volunteers.forEach(v => { %>
              <div class="admin-pending-item">
                <div class="admin-pending-info">
                  <strong><%= v.name %></strong>
                  <div class="admin-pending-sub"><%= v.email %> | <%= v.phone %></div>
                  <div class="admin-pending-sub"><%= v.city %> &middot; Available: <%= v.availability || 'N/A' %></div>
                  <% if (v.skills) { %><div class="admin-pending-sub">Skills: <%= v.skills %></div><% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="admin-card">
          <div class="admin-card-header">
            <h3>🏥 Hospitals Awaiting Verification</h3>
            <span class="admin-badge orange"><%= pendingHospitals.length %></span>
          </div>
          <% if (pendingHospitals.length === 0) { %>
            <div class="admin-empty">✅ No pending hospitals</div>
          <% } else { %>
            <% pendingHospitals.forEach(h => { %>
              <div class="admin-pending-item">
                <div class="admin-pending-info">
                  <strong><%= h.name %></strong>
                  <div class="admin-pending-sub"><%= h.address %>, <%= h.city %></div>
                  <div class="admin-pending-sub"><%= h.email %> | <%= h.phone %></div>
                </div>
                <button class="admin-btn-verify" onclick="verifyHospital('<%= h._id %>')">✓ Verify</button>
              </div>
            <% }) %>
          <% } %>
        </div>

      </div>

      <a href="/" class="back-link">← Back to Home</a>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    function toggleFaq(element) {
      element.parentElement.classList.toggle('active');
    }
  </script>
  <script>
    async function replyFeedback(id) {
      const msg = document.getElementById('reply-' + id).value.trim();
      if (!msg) { alert('Please type a reply message.'); return; }
      const r = await fetch(`/admin/reply-feedback/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg })
      });
      const d = await r.json();
      if (d.success) { alert('✅ Reply sent!'); document.getElementById('reply-' + id).value = ''; }
      else alert('Error: ' + (d.error || 'Failed'));
    }
    async function verifyHospital(id) {
      const r = await fetch(`/admin/verify-hospital/${id}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) { alert('✅ Hospital verified!'); location.reload(); }
    }
    async function verifyRequestDonor(requestId, donorId) {
      if (!confirm('Confirm donor is healthy after screening? The donor will be emailed to GIVE blood and the requester to RECEIVE blood.')) return;
      const r = await fetch(`/admin/verify-request-donor/${requestId}/${donorId}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) { alert(d.message || '✅ Verified and emails sent!'); location.reload(); }
      else alert('Error: ' + (d.error || 'Failed'));
    }
    async function rejectRequestDonor(requestId, donorId) {
      if (!confirm('Mark donor as not fit after screening?')) return;
      const r = await fetch(`/admin/reject-request-donor/${requestId}/${donorId}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) location.reload();
      else alert('Error: ' + (d.error || 'Failed'));
    }
  </script>
</body>
</html>
