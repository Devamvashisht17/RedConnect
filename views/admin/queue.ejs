<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Queue Monitor - RedConnect</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🩸</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="admin-wrapper">

    <div class="admin-page-header">
      <div>
        <h1>📋 Live Queue Monitor</h1>
        <p>Real-time blood request priority queue — updates automatically</p>
      </div>
      <a href="/admin/dashboard" class="admin-back-btn">← Back to Dashboard</a>
    </div>

    <!-- QUEUE LEVEL TABS -->
    <div class="queue-tabs">
      <% const icons = { critical:'🚨', emergency:'⚠️', priority:'⭐', normal:'📋' }; %>
      <% const colors = { critical:'#e74c3c', emergency:'#e67e22', priority:'#2980b9', normal:'#27ae60' }; %>
      <% ['critical','emergency','priority','normal'].forEach(level => { %>
        <div class="queue-tab queue-tab-<%= level %>" onclick="scrollToSection('<%= level %>')">
          <span><%= icons[level] %> <%= level.charAt(0).toUpperCase() + level.slice(1) %></span>
          <span class="queue-tab-count" id="tab-count-<%= level %>"><%= snapshot[level]?.length || 0 %></span>
        </div>
      <% }) %>
      <div class="queue-tab queue-tab-fulfilled" onclick="scrollToSection('fulfilled')">
        <span>✅ Completed</span>
        <span class="queue-tab-count"><%= fulfilled.length %></span>
      </div>
    </div>

    <!-- QUEUE SECTIONS -->
    <% ['critical','emergency','priority','normal'].forEach(level => { %>
      <div class="queue-section-block queue-block-<%= level %>" id="section-<%= level %>">
        <div class="queue-block-header">
          <div class="queue-block-title">
            <span class="queue-block-icon"><%= icons[level] %></span>
            <h2><%= level.charAt(0).toUpperCase() + level.slice(1) %> Queue</h2>
          </div>
          <span class="queue-block-count" id="count-<%= level %>"><%= snapshot[level]?.length || 0 %> requests</span>
        </div>

        <% if (!snapshot[level] || snapshot[level].length === 0) { %>
          <div class="queue-empty-state">
            <div class="queue-empty-icon">✅</div>
            <p>No requests in this queue</p>
          </div>
        <% } else { %>
          <div class="queue-cards-grid">
            <% snapshot[level].forEach(entry => { %>
              <div class="queue-entry-card">
                <div class="qe-position">#<%= entry.position %></div>
                <div class="qe-body">
                  <div class="qe-patient"><%= entry.request?.patientName || 'Unknown' %></div>
                  <div class="qe-meta">
                    <span class="blood-tag"><%= entry.request?.bloodGroup %></span>
                    <span class="qe-hospital">🏥 <%= entry.request?.hospitalName || '—' %></span>
                    <span class="qe-city">📍 <%= entry.request?.city || '—' %></span>
                  </div>
                </div>
                <div class="qe-score">
                  <div class="qe-score-val"><%= entry.priorityScore %></div>
                  <div class="qe-score-label">Priority Score</div>
                </div>
                <div class="qe-wait">
                  <div class="qe-wait-val">~<%= entry.estimatedWait %></div>
                  <div class="qe-wait-label">min wait</div>
                </div>
                <div class="qe-actions">
                  <% if (level !== 'critical') { %>
                    <button class="qe-escalate-btn" onclick="markCritical('<%= entry.request?._id %>')">🚨 Escalate</button>
                  <% } %>
                  <button class="qe-fulfill-btn" onclick="fulfillRequest('<%= entry.request?._id %>', this)">✅ Fulfill</button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>

    <!-- FULFILLED / COMPLETED SECTION -->
    <div class="queue-section-block queue-block-fulfilled" id="section-fulfilled">
      <div class="queue-block-header">
        <div class="queue-block-title">
          <span class="queue-block-icon">✅</span>
          <h2>Completed Requests</h2>
        </div>
        <span class="queue-block-count"><%= fulfilled.length %> fulfilled</span>
      </div>
      <% if (fulfilled.length === 0) { %>
        <div class="queue-empty-state">
          <div class="queue-empty-icon">📋</div>
          <p>No fulfilled requests yet</p>
        </div>
      <% } else { %>
        <div class="queue-cards-grid">
          <% fulfilled.forEach(entry => { %>
            <div class="queue-entry-card fulfilled-card">
              <div class="qe-position" style="color:#27ae60">✅</div>
              <div class="qe-body">
                <div class="qe-patient"><%= entry.request?.patientName || 'Unknown' %></div>
                <div class="qe-meta">
                  <span class="blood-tag"><%= entry.request?.bloodGroup %></span>
                  <span class="qe-hospital">🏥 <%= entry.request?.hospitalName || '—' %></span>
                  <span class="qe-city">📍 <%= entry.request?.city || '—' %></span>
                </div>
              </div>
              <div class="qe-score">
                <div class="qe-score-val" style="color:#27ae60; font-size:1rem;">Fulfilled</div>
                <div class="qe-score-label"><%= entry.fulfilledAt ? new Date(entry.fulfilledAt).toLocaleDateString() : '' %></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <%- include('../partials/footer') %>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.emit('join_queue_monitor');
    socket.on('queue_snapshot', snapshot => {
      ['critical','emergency','priority','normal'].forEach(level => {
        const count    = document.getElementById(`count-${level}`);
        const tabCount = document.getElementById(`tab-count-${level}`);
        const len = snapshot[level]?.length || 0;
        if (count)    count.textContent    = `${len} requests`;
        if (tabCount) tabCount.textContent = len;
      });
    });

    function scrollToSection(level) {
      document.getElementById(`section-${level}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function markCritical(requestId) {
      if (!confirm('Escalate to Critical?')) return;
      const r = await fetch(`/admin/mark-critical/${requestId}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) location.reload();
    }

    async function fulfillRequest(requestId, btn) {
      if (!confirm('Mark this request as fulfilled? It will be removed from the active queue.')) return;
      const r = await fetch(`/admin/fulfill/${requestId}`, { method: 'POST' });
      const d = await r.json();
      if (d.success) location.reload();
      else alert('Error: ' + d.error);
    }
  </script>
</body>
</html>